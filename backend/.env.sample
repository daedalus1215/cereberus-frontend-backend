NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Server-side password-field encryption
ENCRYPTION_KEY=
ENCRYPTION_SALT=

# Registration is open outside production unless this is set to false
ALLOW_REGISTRATION=

# CORS origins: FRONTEND_ORIGIN is a comma-separated list, FRONTEND_URL a single one
FRONTEND_URL=http://localhost:5173

# Set both to serve HTTPS directly; leave unset when a reverse proxy terminates TLS
SSL_KEY_PATH=
SSL_CERT_PATH=
